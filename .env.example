# Copie este arquivo para ".env" antes de subir o ambiente:
#   cp .env.example .env
# Todas as variáveis são obrigatórias: o docker-compose.yml não tem valores
# padrão embutidos e falha com uma mensagem clara se alguma estiver faltando.
# Os valores abaixo são apenas para desenvolvimento local.

# ---------------------------------------------------------------------------
# Banco de dados (Postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital123
POSTGRES_DB=hospital_db
# Porta exposta do Postgres na máquina host
POSTGRES_PORT=5432

# Porta exposta do Adminer (cliente web para o banco)
ADMINER_PORT=8080

# ---------------------------------------------------------------------------
# API (NestJS)
# ---------------------------------------------------------------------------
# Conexão usada pela API e pelo Prisma ao rodar fora do Docker.
# No docker-compose, a API recebe uma URL própria apontando para o host "db".
DATABASE_URL=postgresql://hospital:hospital123@localhost:5432/hospital_db
API_PORT=3001
# Origem permitida para chamadas do navegador à API
CORS_ORIGIN=http://localhost:3000
# Requisições por minuto por IP antes de responder 429
RATE_LIMIT_PER_MINUTE=600
# Swagger em /docs (true/false). Desligue em ambientes expostos.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------
# URL da API usada pelo servidor do Next (lida em runtime, nunca no build).
# No docker-compose, o web recebe http://api:3001.
API_URL=http://localhost:3001
WEB_PORT=3000
